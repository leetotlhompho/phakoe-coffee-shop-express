# Copy to .env (or set these in the Render dashboard). Never commit real secrets.
NODE_ENV=development
PORT=4000

# --- Security ---
# Required in production: a long random string (32+ characters).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
TOKEN_TTL_HOURS=8

# First administrator, created automatically when no admin exists yet.
# Required in production. In development it defaults to admin@brewhaven.local / Admin123!
ADMIN_NAME=Phakoe's Coffee Shop Express Administrator
ADMIN_EMAIL=admin@brewhaven.local
ADMIN_PASSWORD=Admin123!

# --- CORS: your React site(s), comma separated. Supports wildcards like https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Storage (pick ONE) ---
# 1) File-based key-value store (default). On Render this needs a persistent disk, e.g. DATA_FILE=/var/data/brewhaven-db.json
DATA_FILE=./data/brewhaven-db.json
# 2) Redis-compatible key-value database (e.g. a free Upstash Redis). When set, it replaces the file store.
# REDIS_URL=rediss://default:password@host:port
